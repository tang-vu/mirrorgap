{
  "name": "@mirrorgap/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MirrorGap web server: REST API, SSE stream, and observatory UI.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mirrorgap/cmc": "workspace:*",
    "@mirrorgap/core": "workspace:*",
    "@mirrorgap/runtime": "workspace:*",
    "@mirrorgap/storage": "workspace:*",
    "gsap": "^3.15.0",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
