# MirrorGap configuration — copy to .env and edit. Never commit .env.

# Data mode: auto | live | fixture
#   auto    → live when CMC_API_KEY is set, fixture otherwise (dev default)
#   live    → requires CMC_API_KEY; fails loudly when CMC is unreachable
#   fixture → deterministic synthetic data (demo/dev)
MIRRORGAP_DATA_MODE=auto

# CoinMarketCap API key — required for live mode. Keep it secret.
CMC_API_KEY=

# SQLite database file (inside docker: /data/mirrorgap.db)
MIRRORGAP_DB_PATH=./data/mirrorgap.db

# Scan cadence (seconds, min 15) and watchlist cap
MIRRORGAP_SCAN_INTERVAL=60
MIRRORGAP_WATCH_LIMIT=40

# Confirmation: consecutive anomalous scans before an event is confirmed
MIRRORGAP_CONFIRM_SCANS=2

# Severity bands (percent; each must exceed the previous)
MIRRORGAP_THRESHOLD_INFO=0.25
MIRRORGAP_THRESHOLD_WATCH=0.5
MIRRORGAP_THRESHOLD_HIGH=1.0
MIRRORGAP_THRESHOLD_CRITICAL=2.0

# Fixture scenario: static | incident_cycle
MIRRORGAP_FIXTURE_SCENARIO=incident_cycle
# Boot-time deterministic history replay (fixture only, 0 = off)
MIRRORGAP_SEED_TICKS=0

# Web server
PORT=8787
# Token required for POST/DELETE mutations from non-loopback callers
MIRRORGAP_SCAN_TOKEN=
# Public base URL — included in alert payloads as incident/capsule links
MIRRORGAP_PUBLIC_URL=

# Ed25519 receipt signing — base64 pkcs8 private key (generate: mirrorgap doctor --genkey)
# Public key is derived and exposed via /api/v1/verification-key. Never commit this.
MIRRORGAP_SIGNING_KEY=

# Retention: telemetry rows older than N days are pruned after each scan
MIRRORGAP_RETENTION_DAYS=30

# Alerts — all optional. Destinations appear as labels only; URLs never leak.
MIRRORGAP_ALERT_WEBHOOK_URL=
MIRRORGAP_DISCORD_WEBHOOK_URL=
MIRRORGAP_TELEGRAM_BOT_TOKEN=
MIRRORGAP_TELEGRAM_CHAT_ID=
MIRRORGAP_ALERT_MIN_SEVERITY=high

# Optional LLM-assisted incident narrative (engine stays authoritative)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
