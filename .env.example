# ---------------------------------------------------------------------------
# MirrorGap environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored — never commit secrets.
# ---------------------------------------------------------------------------

# CoinMarketCap Pro API key (server-side only, never sent to the browser).
# Get one at https://pro.coinmarketcap.com/account
# Required for live mode. Leave empty to run in fixture mode.
CMC_API_KEY=

# Data mode: "auto" | "live" | "fixture"
#   auto    - live when CMC_API_KEY is set, fixture otherwise (recommended)
#   live    - require a working CMC key; fail fast without one
#   fixture - deterministic synthetic data for development/demo (always labelled)
MIRRORGAP_DATA_MODE=auto

# Where the SQLite database lives. Defaults to ./data/mirrorgap.db
MIRRORGAP_DB_PATH=./data/mirrorgap.db

# Parity-gap severity thresholds (percent). Defaults shown.
MIRRORGAP_THRESHOLD_INFO=0.25
MIRRORGAP_THRESHOLD_WATCH=0.5
MIRRORGAP_THRESHOLD_HIGH=1.0
MIRRORGAP_THRESHOLD_CRITICAL=2.0

# Scans required to confirm a candidate anomaly (set 1 for instant demos)
MIRRORGAP_CONFIRM_SCANS=2

# Seconds between automatic scans when watch/scheduler is running (>=60)
MIRRORGAP_SCAN_INTERVAL=60

# Freshness windows in seconds for the tokenized-aggregate reference quote.
# fresh <= MIRRORGAP_FRESH_SECONDS, aging <= MIRRORGAP_AGING_SECONDS, else stale.
MIRRORGAP_FRESH_SECONDS=120
MIRRORGAP_AGING_SECONDS=600

# Optional token required in `x-mirrorgap-token` header to call POST /api/v1/scan.
# Empty = scan endpoint open to localhost callers only.
MIRRORGAP_SCAN_TOKEN=

# OPTIONAL: OpenAI-compatible endpoint for the bounded explanation layer.
# The product works fully without these. When unset, the deterministic
# narrator is used and no data leaves the process.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Max assets watched per scan cycle (1-250). One batched quotes call covers all.
MIRRORGAP_WATCH_LIMIT=40

# Optional Ed25519 private key (base64) to sign evidence receipts.
# Generate: node -e "const c=require('crypto');const {publicKey,privateKey}=c.generateKeyPairSync('ed25519');console.log(privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# Empty = receipts are hash-verified but unsigned.
MIRRORGAP_SIGNING_KEY=

# Web server port.
PORT=8787

# Set to 1 to disable the automatic scan loop in the web server.
MIRRORGAP_NO_LOOP=
